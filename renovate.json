{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "enabledManagers": ["nix", "github-actions"],
  "automerge": true,
  "automergeType": "branch",
  "baseBranchPatterns": ["main"],
  "branchConcurrentLimit": 5,
  "configMigration": false,
  "dependencyDashboard": false,
  "dependencyDashboardApproval": false,
  "prCreation": "approval",
  "semanticCommits": "enabled",
  "semanticCommitScope": "deps",
  "suppressNotifications": ["configErrorIssue", "missingCredentialsError"],
  "vulnerabilityAlerts": {
    "enabled": false
  },
  "nix": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 5am on monday"]
  },
  "packageRules": [
    {
      "description": "Synchronize Python declarations and uv.lock after updating the Nix input",
      "matchManagers": ["nix"],
      "postUpgradeTasks": {
        "commands": ["nix run .#update-python-deps"],
        "executionMode": "branch",
        "fileFilters": [
          "pyproject.toml",
          "uv.lock",
          ".python-version",
          "pkgs/steam/arm64/proton/configure.py"
        ]
      }
    },
    {
      "description": "Update runner-hosted GitHub Actions independently of Nix packages",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions",
      "groupSlug": "github-actions"
    }
  ]
}
