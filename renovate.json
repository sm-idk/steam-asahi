{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "automerge": true,
  "automergeType": "branch",
  "branchConcurrentLimit": 1,
  "dependencyDashboard": false,
  "ignoreTests": false,
  "prCreation": "never",
  "rebaseWhen": "behind-base-branch",
  "nix": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 5am on monday"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update the Renovate version used by its own workflow",
      "managerFilePatterns": ["/^\\.github/workflows/renovate\\.yml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+renovate-version: (?<currentValue>\\S+)"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Keep GitHub Actions immutable while following releases",
      "matchManagers": ["github-actions"],
      "pinDigests": true
    }
  ]
}
