+/// Keep VM control sockets separate from host desktop service sockets
+pub fn runtime_dir() -> Result<PathBuf> {
+    let path = env::var_os("MUVM_RUNTIME_DIR")
+        .or_else(|| env::var_os("XDG_RUNTIME_DIR"))
+        .map(PathBuf::from)
+        .context("Failed to read MUVM_RUNTIME_DIR or XDG_RUNTIME_DIR")?;
+    ensure!(
+        path.is_absolute(),
+        "muvm runtime directory must be an absolute path"
+    );
+    ensure!(
+        path.to_str().is_some(),
+        "muvm runtime directory must be valid UTF-8"
+    );
+    Ok(path)
+}
