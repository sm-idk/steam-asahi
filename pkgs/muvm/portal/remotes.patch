+pub fn bridge_registered<T: ProtocolHandler>(socket: UnixStream, token: [u8; 16]) -> Result<()> {
+    let epoll = Epoll::new(EpollCreateFlags::EPOLL_CLOEXEC)?;
+    socket.set_nonblocking(true)?;
+    let clients = Rc::new(RefCell::new(HashMap::new()));
+    let sub_poll = SubPoll::new(&epoll, clients.clone());
+    let mut protocol = T::new();
+    protocol.mark_portal_remote();
+    let client = Client::new_with_registration(socket, protocol, sub_poll, Some(token))?;
+    let result = (|| -> Result<()> {
+        // The host also checks registry STATUS before exposing the app FD:
+        // GPU command submission alone does not acknowledge token consumption
+        std::io::stdout().write_all(b"READY\n")?;
+        std::io::stdout().flush()?;
+        while !clients.borrow().is_empty() {
+            let mut events = [EpollEvent::empty(); 16];
+            let count = match epoll.wait(&mut events, EpollTimeout::NONE) {
+                Err(Errno::EINTR) => continue,
+                result => result?,
+            };
+            for event in &events[..count] {
+                if !clients.borrow().contains_key(&event.data()) {
+                    continue;
+                }
+                if event
+                    .events()
+                    .intersects(EpollFlags::EPOLLERR | EpollFlags::EPOLLHUP)
+                {
+                    return Ok(());
+                }
+                client
+                    .borrow_mut()
+                    .process_epoll(event.data(), event.events());
+            }
+        }
+        Ok(())
+    })();
+    client.borrow_mut().sub_poll.close();
+    result
+}
