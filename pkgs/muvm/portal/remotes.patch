+fn process_client_properties(data: &mut [u8], portal_remote: bool) -> Result<()> {
+    let body = Pod::structure(data)?;
+    let props = Pod::next(body, &mut 0)?;
+    if props.kind != SPA_TYPE_STRUCT {
+        return Err(Errno::EPROTO.into());
+    }
+    let mut at = 0;
+    let count = Pod::next(props.data, &mut at)?.integer()? as usize;
+    // Every key/value pair needs at least two aligned POD headers
+    if count > props.data.len() / 16 {
+        return Err(Errno::EPROTO.into());
+    }
+    let mut replacements = Vec::new();
+    for _ in 0..count {
+        let key_at = at;
+        let key = Pod::next(props.data, &mut at)?.string()?;
+        let value = Pod::next(props.data, &mut at)?;
+        value.string()?;
+        // Registered remotes retain portal permissions; the private marker
+        // would select muvm's separate camera compatibility policy
+        if portal_remote && key == c"pipewire.access.muvm00.app_id" {
+            return Err(Errno::EACCES.into());
+        }
+        if !portal_remote && key == c"pipewire.access.portal.app_id" {
+            replacements.push(16 + key_at + 8);
+        }
+    }
+    for start in replacements {
+        let replacement = c"pipewire.access.muvm00.app_id".to_bytes_with_nul();
+        let target = data
+            .get_mut(start..start + replacement.len())
+            .ok_or(Errno::EPROTO)?;
+        target.copy_from_slice(replacement);
+    }
+    Ok(())
