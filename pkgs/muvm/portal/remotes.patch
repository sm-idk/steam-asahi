+struct Pod<'a> {
+    kind: u32,
+    data: &'a [u8],
+}
+
+impl<'a> Pod<'a> {
+    fn next(data: &'a [u8], at: &mut usize) -> Result<Self> {
+        let size = read_u32(data, *at)? as usize;
+        let kind = read_u32(data, at.checked_add(4).ok_or(Errno::EPROTO)?)?;
+        let start = at.checked_add(8).ok_or(Errno::EPROTO)?;
+        let end = start.checked_add(size).ok_or(Errno::EPROTO)?;
+        let padded = end.checked_add(7).ok_or(Errno::EPROTO)? & !7;
+        if padded > data.len() {
+            return Err(Errno::EPROTO.into());
+        }
+        let body = data.get(start..end).ok_or(Errno::EPROTO)?;
+        *at = padded;
+        Ok(Self { kind, data: body })
+    }
+
+    fn structure(data: &'a [u8]) -> Result<&'a [u8]> {
+        let pod = Self::next(data, &mut 0)?;
+        if pod.kind != SPA_TYPE_STRUCT {
+            return Err(Errno::EPROTO.into());
+        }
+        Ok(pod.data)
+    }
+
+    fn integer(&self) -> Result<u32> {
+        if self.kind != SPA_TYPE_INT || self.data.len() != 4 {
+            return Err(Errno::EPROTO.into());
+        }
+        read_u32(self.data, 0)
+    }
+
+    fn string(&self) -> Result<&'a CStr> {
+        if self.kind != SPA_TYPE_STRING {
+            return Err(Errno::EPROTO.into());
+        }
+        Ok(CStr::from_bytes_with_nul(self.data)?)
+    }
+
+    fn descriptor(&self) -> Result<u64> {
+        if self.kind != SPA_TYPE_FD || self.data.len() != 8 {
+            return Err(Errno::EPROTO.into());
+        }
+        Ok(u64::from_ne_bytes(self.data.try_into()?))
+    }
+}
