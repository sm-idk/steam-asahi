{
  lib,
  coreutils,
  curl,
  gnused,
  python315Packages,
  writeShellApplication,
  finalAttrs,
  manifestRoot,
  archive,
  packageFile,
}:

let
  python = python315Packages.python.withPackages (packages: [ packages.vdf ]);
in
writeShellApplication {
  name = "update-${finalAttrs.pname}";
  runtimeInputs = [
    coreutils
    curl
    gnused
    python
  ];
  text = ''
    release=$(curl --fail --silent --show-error ${lib.escapeShellArg finalAttrs.passthru.manifestUrl} | python3.15 -c '
    import re
    import sys
    import vdf

    release = vdf.load(sys.stdin)["${manifestRoot}"]
    version = release["version"]
    filename = release["${archive}"]["file"]
    if not (
        re.fullmatch(r"[0-9]+", version)
        and re.fullmatch(r"${archive}\.zip\.[0-9a-f]{40}", filename)
    ):
        raise SystemExit("unrecognized Steam manifest")
    print(version, filename)
    ')
    read -r version filename <<< "$release"
    if [[ "$version" == "${finalAttrs.version}" && "$filename" == "${builtins.baseNameOf finalAttrs.src.url}" ]]; then
      echo "${finalAttrs.pname} $version is already up to date"
      exit 0
    fi

    package=${lib.escapeShellArg packageFile}
    backup=$(mktemp)
    cp "$package" "$backup"
    trap 'cp "$backup" "$package"; rm -f "$backup"' EXIT
    sed -i -E \
      's#^([[:blank:]]*url = ")https://client-update\.fastly\.steamstatic\.com/${archive}\.zip\.[0-9a-f]+(";)#\1https://client-update.fastly.steamstatic.com/'"$filename"'\2#' \
      "$package"
    if [[ "$version" == "${finalAttrs.version}" ]]; then
      version=skip
    fi
    # The caller supplies the command generated by nix-update-script
    "$@" --version="$version"
    trap - EXIT
    rm -f "$backup"
  '';
}
